# ==========================================
# 《大昌日報》（Ta Chang Daily）發刊配置設定範本
# ==========================================

# 報社基本資訊
NEWSPAPER_TITLE="大昌日報"
NEWSPAPER_SUBTITLE="Ta Chang Daily"
NEWSPAPER_MOTTO="“All the News That's Fit to Scrape.” — 凡撈得到的，皆宜刊印"
PUBLISH_TIMEZONE="Asia/Taipei"

# 發刊時間與排程
PUBLISH_CRON="0 8 * * *"
PUBLISH_TIME="08:00"

# 篇目配置與配比
TOTAL_STORIES_COUNT=9
ENABLE_EDITORIAL=true
STOCK_STORIES_MAIN=1
STOCK_STORIES_NAV_EXPAND=3
TAIWAN_POLITICS_COUNT=2

# 負面過濾清單（以逗號分隔，嚴格排除之題材或關鍵字）
EXCLUDED_KEYWORDS="軍演,實彈射擊,禁航區,認知作戰,網軍,假訊息攻擊"

# 新聞擷取設定
MCP_SERVER="mesh-news"
FETCH_NEWS_LIMIT=40
FALLBACK_WEB_SEARCH=true

# Git 與發布設定
GIT_REMOTE="origin"
GIT_BRANCH="main"
BASE_URL="https://yojwei.github.io/my_news"
